		Parent = header,
	})
	E.solvedStat = statBlock(header, "Solved", "solved", "0")
	E.timeStat = statBlock(header, "Time", "time", "30")
	E.bestStat = statBlock(header, "Best", "best", "0")

	local quit = Ui.button({
		Name = "Quit",
		style = "quit",
		radius = UDim.new(0.5, 0),
		ZIndex = 3,
		Parent = header,
		onClick = function()
			if clickOk() then
