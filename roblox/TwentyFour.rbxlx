	for _, op in Solver.OPS do
		local b = Ui.button({
			Name = "Op" .. op,
			style = "opkey",
			Text = Solver.GLYPH[op],
			FontFace = Ui.serif(600),
			ZIndex = 3,
			Parent = controls,
			onClick = function()
				Play.onOpClick(op)
			end,
		})
		table.insert(E.opKeys, b)
	end
	local function act(name, label, style, fn)
		local b = Ui.button({
			Name = name,
			style = style,
			Text = label,
			FontFace = Ui.sans(600),
			ZIndex = 3,
			Parent = controls,
			onClick = fn,
		})
		b.label = label
		b.primary = style == "primary"
		return b
	end
	E.clearBtn = act("Clear", "Clear", "btn", function()
		if clickOk() then
			Play.clearEquation()
