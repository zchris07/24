	-- header (+ rule) --------------------------------------------------------
	local header = Ui.new("CanvasGroup", {
		Name = "Header",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 3,
		Visible = false,
		Parent = root,
	})
